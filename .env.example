# Copy this file to `.env` (which is git-ignored) and fill in ONE key.
# NEVER commit the real .env file or paste a real key into any tracked file.

# Option 1 (FREE, recommended): Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=_

# Option 2 (paid): Anthropic key from https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Optional
# AI_PROVIDER=gemini            # or "anthropic"; default: gemini if GEMINI_API_KEY is set
# GEMINI_MODEL=gemini-2.5-flash # change if Google retires/renames the model
# ANTHROPIC_MODEL=claude-sonnet-4-6
# PORT=3000
# RATE_LIMIT_PER_MIN=20

# Live mandi data from data.gov.in (optional — falls back to static demo prices)
# Free key at: https://data.gov.in/user/register
# DATAGOV_API_KEY=

# Twilio phone & WhatsApp integration (optional — needed for voice call-in / WhatsApp intake)
# Sign up at: https://console.twilio.com/
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
